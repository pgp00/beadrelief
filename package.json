{
  "name": "beadrelief",
  "version": "0.2.0",
  "description": "Turn any image into an editable bead pattern — locally in your browser.",
  "private": true,
  "homepage": "https://pgp00.github.io/beadrelief/",
  "repository": {
    "type": "git",
    "url": "https://github.com/pgp00/beadrelief.git"
  },
  "bugs": {
    "url": "https://github.com/pgp00/beadrelief/issues"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "packageManager": "npm@11.17.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/dev-server.cjs",
    "build": "node scripts/clean-dist.cjs && tsc -p tsconfig.build.json && node scripts/post-build.cjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "preview": "node scripts/dev-server.cjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "sample": "npm run build && node scripts/generate-sample.mjs",
    "verify": "npm run build && node --test tests/*.test.mjs && node scripts/generate-sample.mjs",
    "release:prepare": "npm run verify && node scripts/generate-checksums.mjs"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/three": "^0.184.1",
    "playwright-core": "^1.62.1",
    "typescript": "^5.4.0"
  }
}
